<Project>
  <!-- Local Anthology switch. Precedence: -p:ProwlLocalAnthology=false, then prowl.local.props (gitignored),
       then the PROWL_LOCAL_ANTHOLOGY environment variable. Default is the sibling AnthologyECS checkout:
       this source needs Graphite types newer than the 3.9.3 NuGet packages. -->
  <Import Project="$(MSBuildThisFileDirectory)prowl.local.props" Condition="Exists('$(MSBuildThisFileDirectory)prowl.local.props')" />

  <PropertyGroup>
    <ProwlLocalAnthology Condition="'$(ProwlLocalAnthology)' == ''">$(PROWL_LOCAL_ANTHOLOGY)</ProwlLocalAnthology>
    <ProwlLocalAnthology Condition="'$(ProwlLocalAnthology)' == '1'">true</ProwlLocalAnthology>
    <ProwlLocalAnthology Condition="'$(ProwlLocalAnthology)' != 'false'">true</ProwlLocalAnthology>
    <AnthologyDir>$(MSBuildThisFileDirectory)..\AnthologyECS\</AnthologyDir>
    <ProwlPackageVersion>3.9.3</ProwlPackageVersion>
  </PropertyGroup>
</Project>